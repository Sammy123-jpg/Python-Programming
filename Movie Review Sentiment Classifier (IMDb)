        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "\n",
        "# 1. Download the IMDb Movie Reviews dataset\n",
        "print(\"Downloading data...\")\n",
        "url = \"https://raw.githubusercontent.com/Ankit152/IMDB-sentiment-analysis/master/IMDB-Dataset.csv\"\n",
        "df = pd.read_csv(url)\n",
        "\n",
        "# 2. Show first 5 rows\n",
        "print(\"Dataset loaded! Here is what it looks like:\")\n",
        "display(df.head())\n",
        "\n",
        "# 3. Make graphs (EDA)\n",
        "df[\"word_count\"] = df[\"review\"].apply(lambda x: len(str(x).split()))\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "sns.countplot(x=\"sentiment\", data=df, ax=axes[0], palette=[\"#2ecc71\", \"#e74c3c\"])\n",
        "axes[0].set_title(\"Positive vs Negative Reviews\")\n",
        "\n",
        "sns.histplot(df[\"word_count\"], bins=30, ax=axes[1], color=\"#3498db\")\n",
        "axes[1].axvline(200, color=\"red\", linestyle=\"--\", label=\"Cutoff (200 words)\")\n",
        "axes[1].set_title(\"Length of Reviews\")\n",
        "axes[1].legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 4. Clean and convert text to numbers for Neural Networks\n",
        "df[\"cleaned\"] = (\n",
        "    df[\"review\"].str.replace(r\"<.*?>\", \"\", regex=True).str.lower()\n",
        ")\n",
        "df[\"label\"] = df[\"sentiment\"].map({\"positive\": 1, \"negative\": 0})\n",
        "\n",
        "tokenizer = Tokenizer(num_words=10000, oov_token=\"<OOV>\")\n",
        "tokenizer.fit_on_texts(df[\"cleaned\"])\n",
        "\n",
        "# Pad sequences so all reviews are exactly 200 words long\n",
        "X = pad_sequences(\n",
        "    tokenizer.texts_to_sequences(df[\"cleaned\"]), maxlen=200, padding=\"post\"\n",
        ")\n",
        "y = df[\"label\"].values\n",
        "\n",
        "print(\"\\nSuccess! Data is cleaned and ready for Neural Networks:\")\n",
        "print(f\"X shape (Input matrix): {X.shape}\")\n",
        "print(f\"y shape (Labels): {y.shape}\")"
